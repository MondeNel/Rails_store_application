<div class="breadcrumb">
  <%= link_to "<- Back to products", products_path, class: "back-link" %>
</div>

<div class="page-header">
  <h1><%= @product.name %></h1>

  <div class="action-group">
    <%= link_to "Edit", edit_product_path(@product), class: "btn btn-secondary" %>
    <%= button_to "Delete", @product, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
  </div>
</div>
